# Copia este archivo a .env y llena los valores reales.
# .env NUNCA se sube a git (ya está en .gitignore).

# Supabase (Proyecto > Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (usar un token de API con permiso solo sobre el bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Enlaces privados (H de la especificación): dos códigos largos,
# uno para Alejandro y otro para David. Se generan con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
LINK_CODE_ALEJANDRO=
LINK_CODE_DAVID=
