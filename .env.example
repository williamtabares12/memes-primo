# Copia este archivo a .env y llena los valores reales.
# .env NUNCA se sube a git (ya está en .gitignore).

# Supabase (Proyecto > Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (usar un token de API con permiso solo sobre el bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Enlaces privados (H de la especificación): dos códigos largos,
# uno para Alejandro y otro para David. Se generan con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
LINK_CODE_ALEJANDRO=
LINK_CODE_DAVID=

# Aviso de publicaciones directas por ntfy (docs/especificacion-directas.md).
# ntfy es gratis y no pide cuenta ni SMS.
# 1. Instala la app "ntfy" (iPhone: App Store) y suscríbete a un tema.
# 2. El tema es la única "clave": que sea largo y al azar, por ejemplo
#      node -e "console.log('memes-' + require('crypto').randomBytes(16).toString('hex'))"
#    Pon ese mismo valor aquí y en la app. Si tiene menos de 16
#    caracteres no se manda nada.
# Sin esta variable el aviso simplemente no se manda.
NTFY_TOPIC=
